<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FFFF">

    <!-- Fondo decorativo superior -->
    <View
        android:layout_width="300dp"
        android:layout_height="250dp"
        android:layout_gravity="top|start"
        android:translationY="-150dp"
        android:translationX="-150dp"
        android:background="@drawable/top_half_circle" />

    <!-- Fondo decorativo inferior -->
    <View
        android:layout_width="300dp"
        android:layout_height="250dp"
        android:layout_gravity="bottom|end"
        android:translationY="150dp"
        android:translationX="150dp"
        android:background="@drawable/bottom_half_circle" />

    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="307dp"
            android:layout_height="242dp"
            app:srcCompat="@drawable/chatgpt_image_2_ago_2025__12_07_17_a_m_" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_border"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="#333333"
            android:textColorHint="#888888" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/input_border"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="#333333"
            android:textColorHint="#888888" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_border"
            android:text="Iniciar sesión"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tvGoToRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="¿No tienes cuenta? Regístrate aquí"
            android:textColor="#EB4749" />

    </LinearLayout>

</FrameLayout>
